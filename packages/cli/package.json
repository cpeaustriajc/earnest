{
  "name": "@earnestjs/cli",
  "version": "0.1.0",
  "description": "The earnest model checker: a launcher that runs the binary from this machine's platform package",
  "homepage": "https://earnest.cpeaustriajc.dev",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cpeaustriajc/earnest.git",
    "directory": "packages/cli"
  },
  "bin": {
    "earnest": "dist/earnest.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "prepack": "node --eval \"fs.rmSync('dist', { recursive: true, force: true })\" && bun run build",
    "assemble": "node scripts/assemble.ts",
    "typecheck": "tsrs --noEmit",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.79.0",
    "tsrs": "^7.1.0-beta.tsrs4",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "@earnestjs/cli-darwin-arm64": "workspace:0.1.0",
    "@earnestjs/cli-darwin-x64": "workspace:0.1.0",
    "@earnestjs/cli-linux-arm64-gnu": "workspace:0.1.0",
    "@earnestjs/cli-linux-x64-gnu": "workspace:0.1.0",
    "@earnestjs/cli-win32-x64-msvc": "workspace:0.1.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
